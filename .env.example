# ─── Attendly environment ──────────────────────────────────────────────
# Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development
# Public origin of the app. Used for CSRF origin checks and reset links.
APP_URL=http://localhost:3000

# PostgreSQL (docker compose default credentials are for local dev only)
DATABASE_URL=postgresql://attendly:attendly_dev_password@localhost:5432/attendly?schema=public

# Redis — optional. Used for rate limiting. Falls back to in-memory if unset.
REDIS_URL=redis://localhost:6379

# 32+ random bytes, hex. Used to HMAC-sign private file URLs.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-a-long-random-hex-string

# Session lifetime in hours
SESSION_TTL_HOURS=12

# ─── Evidence storage ─────────────────────────────────────────────────
# "local" stores files in a private directory (never under /public) and serves
# them through short-lived HMAC-signed URLs. "s3" uses any S3-compatible store
# (AWS S3, Cloudflare R2, MinIO) with presigned URLs.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=attendly-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Email (password reset) ───────────────────────────────────────────
# No SMTP integration is bundled. In development the reset link is printed
# to the server log. Set to "true" ONLY in local dev to also return the link
# in the API response for testing.
DEV_EXPOSE_RESET_LINK=false

# ─── Seed (development only) ──────────────────────────────────────────
SEED_ADMIN_PASSWORD=Admin@Attendly2026
SEED_EMPLOYEE_PASSWORD=Employee@Attendly2026
