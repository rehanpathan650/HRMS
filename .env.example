# ─── Attendly environment ──────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env — it is gitignored.
# NODE_ENV is set by the scripts (`npm run dev` / `npm start`); don't set it here.

# Public origin of the app. Used for CSRF origin checks and reset links.
# Use https://… in production; that also enables HSTS and upgrade-insecure-requests.
APP_URL=http://localhost:3000

# PostgreSQL. Must match POSTGRES_* below when using docker compose.
# Use a long random password for anything beyond your own machine.
POSTGRES_USER=attendly
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=attendly
DATABASE_URL=postgresql://attendly:change-me-to-a-long-random-password@localhost:5432/attendly?schema=public
# Direct (non-pooled) connection for migrations. Locally: same as DATABASE_URL.
# On Neon/Supabase: DATABASE_URL = pooled URL, DIRECT_URL = direct URL.
DIRECT_URL=postgresql://attendly:change-me-to-a-long-random-password@localhost:5432/attendly?schema=public

# Redis — used for rate limiting (falls back to in-memory if REDIS_URL is unset).
REDIS_PASSWORD=change-me-to-a-long-random-password
REDIS_URL=redis://:change-me-to-a-long-random-password@localhost:6379

# 32+ random bytes, hex. Used to HMAC-sign private file URLs. Rotate = all signed URLs expire.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-a-long-random-hex-string

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Set to "true" ONLY when the app runs behind a reverse proxy (nginx, Caddy, a
# load balancer) that overwrites X-Forwarded-For. Otherwise clients could spoof IPs.
TRUST_PROXY=false

# ─── Evidence storage ─────────────────────────────────────────────────
# "local" stores files in a private directory (never under /public) and serves
# them through short-lived HMAC-signed URLs. "s3" uses any S3-compatible store
# (AWS S3, Cloudflare R2, MinIO) with presigned URLs and a PRIVATE bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=attendly-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Email (password reset) ───────────────────────────────────────────
# No SMTP integration is bundled; reset links are printed to the server log.
# "true" also returns the link in the API response — honored only in development.
DEV_EXPOSE_RESET_LINK=false

# Login passwords are never configured here. Run `npm run accounts:provision`
# to issue strong random passwords; they are written to CREDENTIALS.local.md (gitignored).

# ─── Scheduled jobs (Vercel Cron) ─────────────────────────────────────
# Long random value. Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/retention; requests without it are rejected.
CRON_SECRET=
